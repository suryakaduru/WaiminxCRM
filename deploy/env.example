# Copy to .env on the EC2 instance: cp env.example .env  &&  edit values

# Pin a specific image tag (recommended in production). Leave unset to use :latest.
# IMAGE=ghcr.io/suryakaduru/waiminxcrm-app:sha-abcdef0

# Public URL the app will be served at. With Cloudflare Tunnel, set the trycloudflare URL.
SERVER_URL=http://YOUR_PUBLIC_HOST

STORAGE_TYPE=local

# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=REPLACE_ME
FALLBACK_ENCRYPTION_KEY=REPLACE_ME
APP_SECRET=REPLACE_ME
